rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedSuperAdmin() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email == 'fvathyvhmed@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isBootstrappedSuperAdmin() ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveAccount() {
      return isSuperAdmin() || !(
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountDisabled', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banUntilMillis', 0) > request.time.toMillis()
        )
      );
    }

    function isVerifiedEmailUser() {
      return isSignedIn() &&
        ('email' in request.auth.token) &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.size() >= 3 &&
        request.auth.token.email_verified == true;
    }

    function isValidEmailDocId(id) {
      return id is string &&
        id.size() >= 3 &&
        id.size() <= 120 &&
        id.matches('^[a-z0-9_.+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function hasPendingAdminInvite() {
      return isVerifiedEmailUser() &&
        exists(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())).data.assignedRole == 'ADMIN' &&
        get(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())).data.status == 'PENDING' &&
        get(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())).data.email == request.auth.token.email.lower();
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidHttpsUrl(url) {
      return url is string &&
        url.size() >= 10 &&
        url.size() <= 500 &&
        url.matches('^https://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(/.*)?$');
    }

    // --- Entity Validation Helpers ---

    function isValidRoleGrant(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAdminGrant(data) {
      return isValidRoleGrant(data) &&
        data.grantedBy is string && isValidId(data.grantedBy);
    }

    function isValidSystemSettings(data) {
      return data.dailyAiLimitPerUser is int && data.dailyAiLimitPerUser >= 1 && data.dailyAiLimitPerUser <= 100 &&
        data.dailyWriteLimitPerUser is int && data.dailyWriteLimitPerUser >= 10 && data.dailyWriteLimitPerUser <= 500 &&
        data.maxFileUploadBytes is int && data.maxFileUploadBytes >= 102400 && data.maxFileUploadBytes <= 5242880 &&
        data.aiEnabled is bool &&
        data.zeroCostLockActive is bool &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
        data.role in ['STUDENT', 'ADMIN', 'SUPER_ADMIN'] &&
        data.aiCallsToday is int && data.aiCallsToday >= 0 && data.aiCallsToday <= 1000 &&
        data.writesToday is int && data.writesToday >= 0 && data.writesToday <= 5000 &&
        data.quotaDayKey is string && data.quotaDayKey.size() >= 8 && data.quotaDayKey.size() <= 16 &&
        (!('accountDisabled' in data) || data.accountDisabled is bool) &&
        (!('banUntilMillis' in data) || (data.banUntilMillis is int && data.banUntilMillis >= 0)) &&
        (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 200)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidUserPrivatePii(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidFileRecord(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.originalName is string && data.originalName.size() >= 1 && data.originalName.size() <= 120 &&
        data.storedName is string && data.storedName.size() >= 5 && data.storedName.size() <= 100 &&
        data.storedName.matches('^[a-zA-Z0-9_\\-]+\\.(pdf|png|jpg|jpeg)$') &&
        data.mimeType in ['application/pdf', 'image/png', 'image/jpeg'] &&
        data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 5242880 &&
        data.sha256Hex is string && data.sha256Hex.size() == 64 &&
        data.sha256Hex.matches('^[a-fA-F0-9]{64}$') &&
        data.status == 'VERIFIED' &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCourse(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.instructorId is string && isValidId(data.instructorId) &&
        data.instructorName is string && data.instructorName.size() >= 2 && data.instructorName.size() <= 60 &&
        (!('materialLink' in data) || isValidHttpsUrl(data.materialLink)) &&
        data.materialType in ['NOTES', 'PDF_LINK', 'ONEDRIVE_LINK', 'FILE'] &&
        (!('hasAttachment' in data) || data.hasAttachment is bool) &&
        (
          !('hasAttachment' in data) || data.hasAttachment == false || (
            data.attachmentName is string && data.attachmentName.size() >= 1 && data.attachmentName.size() <= 140 &&
            data.attachmentMimeType in ['application/pdf', 'image/png', 'image/jpeg'] &&
            data.attachmentSizeBytes is int && data.attachmentSizeBytes > 0 && data.attachmentSizeBytes <= 2097152 &&
            data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 6 &&
            data.attachmentSha256 is string && data.attachmentSha256.matches('^[a-fA-F0-9]{64}$')
          )
        ) &&
        (!('departmentId' in data) || isValidId(data.departmentId)) &&
        (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 80)) &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40)) &&
        data.published is bool &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidCourseChunk(data) {
      return data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 5 &&
        data.data is string && data.data.size() >= 1 && data.data.size() <= 750000 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidDriveFolderId(id) {
      return id is string && id.size() >= 10 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDriveFolderLink(data) {
      return data.folderId is string && isValidDriveFolderId(data.folderId) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.folderUrl is string && isValidHttpsUrl(data.folderUrl) &&
        data.folderUrl.matches('^https://drive\\.google\\.com/.*') &&
        (!('departmentId' in data) || isValidId(data.departmentId)) &&
        (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() >= 2 && data.departmentName.size() <= 80)) &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40)) &&
        data.addedBy is string && isValidId(data.addedBy) &&
        data.addedByName is string && data.addedByName.size() >= 2 && data.addedByName.size() <= 60 &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidDepartment(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.years is list && data.years.size() >= 1 && data.years.size() <= 12 &&
        data.years[0] is string && data.years[0].size() >= 1 && data.years[0].size() <= 40 &&
        data.createdBy is string && isValidId(data.createdBy) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidQuiz(data) {
      return data.courseId is string && isValidId(data.courseId) &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 180 &&
        (!('startAtMillis' in data) || (data.startAtMillis is int && data.startAtMillis >= 0)) &&
        (!('endAtMillis' in data) || (data.endAtMillis is int && data.endAtMillis >= 0)) &&
        (!('hasImage' in data) || data.hasImage is bool) &&
        (
          !('hasImage' in data) || data.hasImage == false || (
            data.imageName is string && data.imageName.size() >= 1 && data.imageName.size() <= 140 &&
            data.imageMimeType in ['image/png', 'image/jpeg'] &&
            data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 4
          )
        ) &&
        data.questionPrompts is list && data.questionPrompts.size() >= 1 && data.questionPrompts.size() <= 20 &&
        data.questionPrompts[0] is string &&
        data.optionBlocks is list && data.optionBlocks.size() == data.questionPrompts.size() &&
        data.optionBlocks[0] is string &&
        data.published is bool &&
        data.createdBy is string && isValidId(data.createdBy) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAnswerKey(data) {
      return data.quizId is string && isValidId(data.quizId) &&
        data.correctIndices is list && data.correctIndices.size() >= 1 && data.correctIndices.size() <= 20 &&
        data.correctIndices[0] is int &&
        data.passingScore is int && data.passingScore >= 1 && data.passingScore <= 100 &&
        data.updatedBy is string && isValidId(data.updatedBy) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidQuizAttempt(data) {
      return data.userId is string && isValidId(data.userId) &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 60 &&
        data.quizId is string && isValidId(data.quizId) &&
        data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 100 &&
        data.selectedIndices is list && data.selectedIndices.size() >= 1 && data.selectedIndices.size() <= 20 &&
        data.selectedIndices[0] is int &&
        data.status in ['SUBMITTED', 'GRADED', 'CANCELLED_VIOLATION'] &&
        data.score is int && data.score >= 0 && data.score <= 100 &&
        data.graded is bool &&
        (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 200)) &&
        (!('gradedBy' in data) || (data.gradedBy is string && isValidId(data.gradedBy))) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.actorUid is string && isValidId(data.actorUid) &&
        data.actorLabel is string && data.actorLabel.size() >= 2 && data.actorLabel.size() <= 80 &&
        data.action in [
          'AUTH_SUCCESS',
          'AUTH_FAILURE',
          'UNAUTHORIZED_ADMIN_ATTEMPT',
          'ROLE_CHANGED',
          'SETTINGS_CHANGED',
          'QUIZ_SUBMITTED',
          'QUIZ_VIOLATION_CANCELLED',
          'GRADE_FINALIZED',
          'FILE_UPLOAD_VERIFIED',
          'FILE_UPLOAD_REJECTED',
          'RATE_LIMIT_TRIGGERED',
          'QUOTA_WARNING',
          'QUOTA_LOCKED',
          'ACCOUNT_INVITED',
          'NOTIFICATION_SENT',
          'DRIVE_FOLDER_LINKED',
          'ACCOUNT_STATUS_CHANGED',
          'ACCOUNT_BANNED',
          'SUPPORT_MESSAGE_SENT',
          'DEPARTMENT_UPDATED',
          'PROFANITY_BLOCKED',
          'CHAT_MESSAGE_DELETED'
        ] &&
        data.severity in ['INFO', 'WARN', 'HIGH', 'CRITICAL'] &&
        data.targetPath is string && data.targetPath.size() >= 1 && data.targetPath.size() <= 180 &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 400 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidRoleInvite(data) {
      return data.email is string && isValidEmailDocId(data.email) &&
        data.displayNameHint is string && data.displayNameHint.size() >= 2 && data.displayNameHint.size() <= 60 &&
        data.assignedRole in ['STUDENT', 'ADMIN'] &&
        data.invitedBy is string && isValidId(data.invitedBy) &&
        data.invitedByLabel is string && data.invitedByLabel.size() >= 2 && data.invitedByLabel.size() <= 80 &&
        data.status in ['PENDING', 'CLAIMED'] &&
        (!('claimedByUid' in data) || (data.claimedByUid is string && isValidId(data.claimedByUid))) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.body is string && data.body.size() >= 2 && data.body.size() <= 400 &&
        data.category in ['COURSE', 'QUIZ', 'GRADE', 'ROLE', 'SECURITY', 'ANNOUNCEMENT'] &&
        data.targetUid is string && (data.targetUid == 'ALL' || isValidId(data.targetUid)) &&
        data.senderUid is string && isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60 &&
        isValidTimestamp(data.createdAt);
    }

    function isValidSupportMessage(data) {
      return data.channel in ['STUDENT_TO_ADMIN', 'ADMIN_TO_SUPER'] &&
        data.senderUid is string && isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60 &&
        data.senderRole in ['STUDENT', 'ADMIN'] &&
        data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
        data.body is string && data.body.size() >= 2 && data.body.size() <= 800 &&
        data.status in ['OPEN', 'REPLIED'] &&
        (!('attachmentBase64' in data) || (
          data.attachmentBase64 is string && data.attachmentBase64.size() >= 1 && data.attachmentBase64.size() <= 700000 &&
          data.attachmentMimeType in ['image/png', 'image/jpeg'] &&
          data.attachmentName is string && data.attachmentName.size() >= 1 && data.attachmentName.size() <= 140
        )) &&
        (!('replyText' in data) || (data.replyText is string && data.replyText.size() >= 1 && data.replyText.size() <= 800)) &&
        (!('replyAttachmentBase64' in data) || (
          data.replyAttachmentBase64 is string && data.replyAttachmentBase64.size() >= 1 && data.replyAttachmentBase64.size() <= 700000 &&
          data.replyAttachmentMimeType in ['image/png', 'image/jpeg'] &&
          data.replyAttachmentName is string && data.replyAttachmentName.size() >= 1 && data.replyAttachmentName.size() <= 140
        )) &&
        (!('repliedByUid' in data) || (data.repliedByUid is string && isValidId(data.repliedByUid))) &&
        (!('repliedByName' in data) || (data.repliedByName is string && data.repliedByName.size() >= 2 && data.repliedByName.size() <= 60)) &&
        isValidTimestamp(data.createdAt) &&
        isValidTimestamp(data.updatedAt);
    }

    function isValidChatMessage(data) {
      return data.roomId is string && isValidId(data.roomId) &&
        data.senderUid is string && isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 60 &&
        data.senderRole in ['STUDENT', 'ADMIN', 'SUPER_ADMIN'] &&
        data.text is string && data.text.size() <= 800 &&
        (data.text.size() >= 1 || ('attachmentBase64' in data && data.attachmentBase64 is string && data.attachmentBase64.size() >= 1)) &&
        (!('departmentName' in data) || (data.departmentName is string && data.departmentName.size() <= 80)) &&
        (!('academicYear' in data) || (data.academicYear is string && data.academicYear.size() <= 40)) &&
        (!('attachmentBase64' in data) || (
          data.attachmentBase64 is string && data.attachmentBase64.size() >= 1 && data.attachmentBase64.size() <= 700000 &&
          data.attachmentMimeType in ['image/png', 'image/jpeg'] &&
          data.attachmentName is string && data.attachmentName.size() >= 1 && data.attachmentName.size() <= 140
        )) &&
        isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    match /super_admins/{userId} {
      allow get: if isValidId(userId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidId(userId) &&
        incoming().userId == userId &&
        incoming().keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt']) &&
        isValidRoleGrant(incoming());
      allow update: if false;
      allow delete: if isValidId(userId) && isSuperAdmin() && userId != request.auth.uid;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && isAdmin() && isActiveAccount();
      allow list: if isAdmin() && isActiveAccount();
      allow create: if isValidId(userId) &&
        incoming().userId == userId &&
        incoming().keys().hasAll(['userId', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'email', 'grantedBy', 'createdAt', 'updatedAt']) &&
        isValidAdminGrant(incoming()) && (
          (isSuperAdmin() && incoming().grantedBy == request.auth.uid) ||
          (isOwner(userId) && hasPendingAdminInvite() &&
           incoming().email.lower() == request.auth.token.email.lower() &&
           incoming().grantedBy == get(/databases/$(database)/documents/role_invites/$(request.auth.token.email.lower())).data.invitedBy)
        );
      allow update: if false;
      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    match /system_settings/{settingId} {
      allow get: if isSignedIn() && isValidId(settingId);
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidId(settingId) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'dailyAiLimitPerUser', 'dailyWriteLimitPerUser', 'maxFileUploadBytes',
          'aiEnabled', 'zeroCostLockActive', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'dailyAiLimitPerUser', 'dailyWriteLimitPerUser', 'maxFileUploadBytes',
          'aiEnabled', 'zeroCostLockActive', 'updatedBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidSystemSettings(incoming());
      allow update: if isSuperAdmin() &&
        isValidId(settingId) &&
        isValidSystemSettings(incoming()) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'dailyAiLimitPerUser', 'dailyWriteLimitPerUser', 'maxFileUploadBytes',
          'aiEnabled', 'zeroCostLockActive', 'updatedBy', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || (isAdmin() && isActiveAccount()));
      allow list: if isAdmin() && isActiveAccount();
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        incoming().userId == request.auth.uid &&
        (
          incoming().role == 'STUDENT' ||
          (incoming().role == 'SUPER_ADMIN' && isBootstrappedSuperAdmin()) ||
          (incoming().role == 'ADMIN' && (isAdmin() || hasPendingAdminInvite()))
        ) &&
        incoming().aiCallsToday == 0 &&
        incoming().writesToday == 0 &&
        (!('accountDisabled' in incoming()) || incoming().accountDisabled == false) &&
        (!('banUntilMillis' in incoming()) || incoming().banUntilMillis == 0) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'role', 'aiCallsToday', 'writesToday', 'quotaDayKey', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'role', 'aiCallsToday', 'writesToday', 'quotaDayKey',
          'accountDisabled', 'banUntilMillis', 'banReason', 'createdAt', 'updatedAt'
        ]) &&
        isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt && (
          (
            isOwner(userId) &&
            isActiveAccount() &&
            (
              incoming().role == existing().role ||
              (existing().role == 'STUDENT' && incoming().role == 'ADMIN' && hasPendingAdminInvite())
            ) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'aiCallsToday', 'writesToday', 'quotaDayKey', 'updatedAt'
            ])
          ) || (
            isAdmin() &&
            isActiveAccount() &&
            existing().role == 'STUDENT' &&
            userId != request.auth.uid &&
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'banUntilMillis', 'banReason', 'updatedAt'
            ])
          ) || (
            isSuperAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'role', 'aiCallsToday', 'writesToday', 'quotaDayKey',
              'accountDisabled', 'banUntilMillis', 'banReason', 'updatedAt'
            ]) &&
            (
              (!('accountDisabled' in incoming().diff(existing()).affectedKeys()) &&
               !('banUntilMillis' in incoming().diff(existing()).affectedKeys())) ||
              userId != request.auth.uid
            )
          )
        );
      allow delete: if isValidId(userId) && isSuperAdmin() && userId != request.auth.uid;

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isSuperAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll(['userId', 'email', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'email', 'createdAt', 'updatedAt']) &&
          isValidUserPrivatePii(incoming());
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isOwner(userId) &&
          isActiveAccount() &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          isValidUserPrivatePii(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isSuperAdmin();
      }

      match /files/{fileId} {
        allow get: if isValidId(userId) && isValidId(fileId) && isActiveAccount() && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isActiveAccount() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(fileId) &&
          isOwner(userId) &&
          isActiveAccount() &&
          incoming().userId == request.auth.uid &&
          incoming().keys().hasAll([
            'userId', 'originalName', 'storedName', 'mimeType', 'sizeBytes', 'sha256Hex', 'status', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'originalName', 'storedName', 'mimeType', 'sizeBytes', 'sha256Hex', 'status', 'createdAt', 'updatedAt'
          ]) &&
          isValidFileRecord(incoming());
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(fileId) && isActiveAccount() && (isOwner(userId) || isAdmin());
      }
    }

    match /courses/{courseId} {
      allow get: if isSignedIn() && isActiveAccount() && isValidId(courseId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && isActiveAccount() && (resource.data.published == true || isAdmin());
      allow create: if isAdmin() && isActiveAccount() &&
        isValidId(courseId) &&
        incoming().instructorId == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'description', 'instructorId', 'instructorName', 'materialType', 'published', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'description', 'instructorId', 'instructorName', 'materialLink', 'materialType',
          'hasAttachment', 'attachmentName', 'attachmentMimeType', 'attachmentSizeBytes', 'chunkCount', 'attachmentSha256',
          'departmentId', 'departmentName', 'academicYear',
          'published', 'createdAt', 'updatedAt'
        ]) &&
        isValidCourse(incoming());
      allow update: if isAdmin() && isActiveAccount() &&
        isValidId(courseId) &&
        isValidCourse(incoming()) &&
        incoming().instructorId == existing().instructorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'instructorName', 'materialLink', 'materialType',
          'hasAttachment', 'attachmentName', 'attachmentMimeType', 'attachmentSizeBytes', 'chunkCount', 'attachmentSha256',
          'departmentId', 'departmentName', 'academicYear',
          'published', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isActiveAccount() && isValidId(courseId);

      match /chunks/{chunkId} {
        allow get, list: if isSignedIn() && isActiveAccount() && isValidId(courseId) && (
          isAdmin() ||
          get(/databases/$(database)/documents/courses/$(courseId)).data.published == true
        );
        allow create: if isAdmin() && isActiveAccount() &&
          isValidId(courseId) &&
          isValidId(chunkId) &&
          incoming().keys().hasAll(['chunkIndex', 'data', 'createdAt']) &&
          incoming().keys().hasOnly(['chunkIndex', 'data', 'createdAt']) &&
          isValidCourseChunk(incoming()) &&
          exists(/databases/$(database)/documents/courses/$(courseId));
        allow update: if false;
        allow delete: if isAdmin() && isActiveAccount() && isValidId(courseId) && isValidId(chunkId);
      }
    }

    match /drive_folders/{folderDocId} {
      allow get, list: if isSignedIn() && isActiveAccount();
      allow create: if isSuperAdmin() && isActiveAccount() &&
        isValidDriveFolderId(folderDocId) &&
        incoming().folderId == folderDocId &&
        incoming().addedBy == request.auth.uid &&
        incoming().keys().hasAll([
          'folderId', 'title', 'folderUrl', 'addedBy', 'addedByName', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'folderId', 'title', 'folderUrl', 'departmentId', 'departmentName', 'academicYear',
          'addedBy', 'addedByName', 'createdAt', 'updatedAt'
        ]) &&
        isValidDriveFolderLink(incoming());
      allow update: if isSuperAdmin() && isActiveAccount() &&
        isValidDriveFolderId(folderDocId) &&
        isValidDriveFolderLink(incoming()) &&
        incoming().folderId == existing().folderId &&
        incoming().addedBy == existing().addedBy &&
        incoming().addedByName == existing().addedByName &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'folderUrl', 'departmentId', 'departmentName', 'academicYear', 'updatedAt'
        ]);
      allow delete: if isSuperAdmin() && isActiveAccount() && isValidDriveFolderId(folderDocId);
    }

    // Academic Departments & Study Years: Writable ONLY by Admins & Super Admins; Active users read
    match /departments/{deptId} {
      allow get, list: if isSignedIn() && isActiveAccount();
      allow create: if isAdmin() && isActiveAccount() &&
        isValidId(deptId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll(['name', 'years', 'createdBy', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['name', 'years', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidDepartment(incoming());
      allow update: if isAdmin() && isActiveAccount() &&
        isValidId(deptId) &&
        isValidDepartment(incoming()) &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'years', 'updatedAt']);
      allow delete: if isAdmin() && isActiveAccount() && isValidId(deptId);
    }

    match /quizzes/{quizId} {
      allow get: if isSignedIn() && isActiveAccount() && isValidId(quizId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && isActiveAccount() && (resource.data.published == true || isAdmin());
      allow create: if isAdmin() && isActiveAccount() &&
        isValidId(quizId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().keys().hasAll([
          'courseId', 'title', 'durationMinutes', 'questionPrompts', 'optionBlocks', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'courseId', 'title', 'durationMinutes', 'startAtMillis', 'endAtMillis',
          'hasImage', 'imageName', 'imageMimeType', 'chunkCount',
          'questionPrompts', 'optionBlocks', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        isValidQuiz(incoming()) &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId));
      allow update: if isAdmin() && isActiveAccount() &&
        isValidId(quizId) &&
        isValidQuiz(incoming()) &&
        incoming().courseId == existing().courseId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'durationMinutes', 'startAtMillis', 'endAtMillis',
          'hasImage', 'imageName', 'imageMimeType', 'chunkCount',
          'questionPrompts', 'optionBlocks', 'published', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isActiveAccount() && isValidId(quizId);

      // Quiz Figure Image Chunks
      match /assets/{chunkId} {
        allow get, list: if isSignedIn() && isActiveAccount() && isValidId(quizId) && (
          isAdmin() ||
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.published == true
        );
        allow create: if isAdmin() && isActiveAccount() &&
          isValidId(quizId) &&
          isValidId(chunkId) &&
          incoming().keys().hasAll(['chunkIndex', 'data', 'createdAt']) &&
          incoming().keys().hasOnly(['chunkIndex', 'data', 'createdAt']) &&
          isValidCourseChunk(incoming()) &&
          exists(/databases/$(database)/documents/quizzes/$(quizId));
        allow update: if false;
        allow delete: if isAdmin() && isActiveAccount() && isValidId(quizId) && isValidId(chunkId);
      }

      // Split Collection: Protected Answer Key accessible ONLY to Active Admins/SuperAdmins
      match /private/{docId} {
        allow get, list: if isValidId(quizId) && isAdmin() && isActiveAccount();
        allow create: if isAdmin() && isActiveAccount() &&
          isValidId(quizId) &&
          docId == 'answer_key' &&
          incoming().quizId == quizId &&
          incoming().updatedBy == request.auth.uid &&
          incoming().keys().hasAll(['quizId', 'correctIndices', 'passingScore', 'updatedBy', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['quizId', 'correctIndices', 'passingScore', 'updatedBy', 'createdAt', 'updatedAt']) &&
          isValidAnswerKey(incoming()) &&
          exists(/databases/$(database)/documents/quizzes/$(quizId));
        allow update: if isAdmin() && isActiveAccount() &&
          isValidId(quizId) &&
          docId == 'answer_key' &&
          isValidAnswerKey(incoming()) &&
          incoming().quizId == existing().quizId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedBy == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['correctIndices', 'passingScore', 'updatedBy', 'updatedAt']);
        allow delete: if isAdmin() && isActiveAccount() && isValidId(quizId);
      }
    }

    match /quiz_attempts/{attemptId} {
      allow get: if isSignedIn() && isActiveAccount() && isValidId(attemptId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && isActiveAccount() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActiveAccount() &&
        isValidId(attemptId) &&
        attemptId == (request.auth.uid + '_' + incoming().quizId) &&
        incoming().userId == request.auth.uid &&
        incoming().score == 0 &&
        !('gradedBy' in incoming()) &&
        (
          (incoming().status == 'SUBMITTED' && incoming().graded == false) ||
          (incoming().status == 'CANCELLED_VIOLATION' && incoming().graded == true &&
           'cancellationReason' in incoming() && incoming().cancellationReason.size() >= 3)
        ) &&
        incoming().keys().hasAll([
          'userId', 'studentName', 'quizId', 'quizTitle', 'selectedIndices', 'status', 'score', 'graded', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'studentName', 'quizId', 'quizTitle', 'selectedIndices', 'status', 'score', 'graded', 'cancellationReason', 'createdAt', 'updatedAt'
        ]) &&
        isValidQuizAttempt(incoming()) &&
        exists(/databases/$(database)/documents/quizzes/$(incoming().quizId));
      allow update: if isAdmin() && isActiveAccount() &&
        isValidId(attemptId) &&
        isValidQuizAttempt(incoming()) &&
        (existing().status == 'SUBMITTED' || isSuperAdmin()) &&
        incoming().status == 'GRADED' &&
        incoming().graded == true &&
        incoming().gradedBy == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().quizId == existing().quizId &&
        incoming().selectedIndices == existing().selectedIndices &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['score', 'graded', 'status', 'gradedBy', 'updatedAt']);
      allow delete: if isValidId(attemptId) && isSuperAdmin();
    }

    // Security Audit Logs: Read strictly restricted to SUPER_ADMIN only (hidden from Students and Regular Admins)
    match /audit_logs/{logId} {
      allow get, list: if isSuperAdmin();
      allow create: if isSignedIn() &&
        isValidId(logId) &&
        incoming().actorUid == request.auth.uid &&
        incoming().keys().hasAll([
          'actorUid', 'actorLabel', 'action', 'severity', 'targetPath', 'details', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'actorUid', 'actorLabel', 'action', 'severity', 'targetPath', 'details', 'createdAt'
        ]) &&
        isValidAuditLog(incoming());
      allow update, delete: if false;
    }

    match /role_invites/{inviteId} {
      allow get: if isValidEmailDocId(inviteId) && (
        (isAdmin() && isActiveAccount()) ||
        (isVerifiedEmailUser() && request.auth.token.email.lower() == inviteId)
      );
      allow list: if isAdmin() && isActiveAccount();
      allow create: if isAdmin() && isActiveAccount() &&
        isValidEmailDocId(inviteId) &&
        incoming().email == inviteId &&
        incoming().invitedBy == request.auth.uid &&
        incoming().status == 'PENDING' &&
        !('claimedByUid' in incoming()) &&
        (incoming().assignedRole == 'STUDENT' || (incoming().assignedRole == 'ADMIN' && isSuperAdmin())) &&
        incoming().keys().hasAll([
          'email', 'displayNameHint', 'assignedRole', 'invitedBy', 'invitedByLabel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'email', 'displayNameHint', 'assignedRole', 'invitedBy', 'invitedByLabel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidRoleInvite(incoming());
      allow update: if isValidEmailDocId(inviteId) &&
        isValidRoleInvite(incoming()) &&
        incoming().email == existing().email &&
        incoming().invitedBy == existing().invitedBy &&
        incoming().createdAt == existing().createdAt && (
          isSuperAdmin() ||
          (
            isVerifiedEmailUser() &&
            isActiveAccount() &&
            request.auth.token.email.lower() == inviteId &&
            existing().status == 'PENDING' &&
            incoming().status == 'CLAIMED' &&
            incoming().claimedByUid == request.auth.uid &&
            incoming().assignedRole == existing().assignedRole &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidEmailDocId(inviteId) && isActiveAccount() && (
        isSuperAdmin() ||
        (isAdmin() && existing().assignedRole == 'STUDENT')
      );
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isActiveAccount() && isValidId(notificationId) && (
        existing().targetUid == 'ALL' ||
        existing().targetUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && isActiveAccount() && (
        resource.data.targetUid == 'ALL' ||
        resource.data.targetUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAdmin() && isActiveAccount() &&
        isValidId(notificationId) &&
        incoming().senderUid == request.auth.uid &&
        incoming().keys().hasAll([
          'title', 'body', 'category', 'targetUid', 'senderUid', 'senderName', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'title', 'body', 'category', 'targetUid', 'senderUid', 'senderName', 'createdAt'
        ]) &&
        isValidNotification(incoming());
      allow update: if false;
      allow delete: if isAdmin() && isActiveAccount() && isValidId(notificationId);
    }

    // Tiered Support & Escalation Messaging:
    // - Students -> Admins (STUDENT_TO_ADMIN)
    // - Admins ONLY -> Super Admin (ADMIN_TO_SUPER)
    match /support_messages/{messageId} {
      allow get: if isSignedIn() && isActiveAccount() && isValidId(messageId) && (
        isSuperAdmin() ||
        existing().senderUid == request.auth.uid ||
        (isAdmin() && existing().channel == 'STUDENT_TO_ADMIN')
      );
      allow list: if isSignedIn() && isActiveAccount() && (
        isSuperAdmin() ||
        resource.data.senderUid == request.auth.uid ||
        (isAdmin() && resource.data.channel == 'STUDENT_TO_ADMIN')
      );
      allow create: if isSignedIn() && isActiveAccount() &&
        isValidId(messageId) &&
        incoming().senderUid == request.auth.uid &&
        incoming().status == 'OPEN' &&
        !('replyText' in incoming()) &&
        !('repliedByUid' in incoming()) &&
        !('repliedByName' in incoming()) &&
        incoming().keys().hasAll([
          'channel', 'senderUid', 'senderName', 'senderRole', 'subject', 'body', 'status', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'channel', 'senderUid', 'senderName', 'senderRole', 'subject', 'body',
          'attachmentBase64', 'attachmentMimeType', 'attachmentName',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidSupportMessage(incoming()) && (
          (!isAdmin() && incoming().channel == 'STUDENT_TO_ADMIN' && incoming().senderRole == 'STUDENT') ||
          (isAdmin() && !isSuperAdmin() && incoming().channel == 'ADMIN_TO_SUPER' && incoming().senderRole == 'ADMIN')
        );
      allow update: if isSignedIn() && isActiveAccount() &&
        isValidId(messageId) &&
        isValidSupportMessage(incoming()) &&
        incoming().channel == existing().channel &&
        incoming().senderUid == existing().senderUid &&
        incoming().senderName == existing().senderName &&
        incoming().senderRole == existing().senderRole &&
        incoming().subject == existing().subject &&
        incoming().body == existing().body &&
        incoming().createdAt == existing().createdAt &&
        incoming().status == 'REPLIED' &&
        incoming().repliedByUid == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'replyText', 'replyAttachmentBase64', 'replyAttachmentMimeType', 'replyAttachmentName',
          'repliedByUid', 'repliedByName', 'updatedAt'
        ]) && (
          (existing().channel == 'STUDENT_TO_ADMIN' && isAdmin()) ||
          (existing().channel == 'ADMIN_TO_SUPER' && isSuperAdmin())
        );
      allow delete: if isValidId(messageId) && isSuperAdmin();
    }

    // Department & Academic Year Student Group Chat Rooms
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow get, list: if isSignedIn() && isActiveAccount() && isValidId(roomId);
      allow create: if isSignedIn() && isActiveAccount() &&
        isValidId(roomId) &&
        isValidId(messageId) &&
        incoming().roomId == roomId &&
        incoming().senderUid == request.auth.uid &&
        (
          incoming().senderRole == 'STUDENT' ||
          (incoming().senderRole == 'ADMIN' && isAdmin()) ||
          (incoming().senderRole == 'SUPER_ADMIN' && isSuperAdmin())
        ) &&
        incoming().keys().hasAll([
          'roomId', 'senderUid', 'senderName', 'senderRole', 'text', 'createdAt'
        ]) &&
        incoming().keys().hasOnly([
          'roomId', 'departmentName', 'academicYear',
          'senderUid', 'senderName', 'senderRole', 'text',
          'attachmentBase64', 'attachmentMimeType', 'attachmentName',
          'createdAt'
        ]) &&
        isValidChatMessage(incoming());
      allow update: if false;
      allow delete: if isSignedIn() && isActiveAccount() &&
        isValidId(roomId) && isValidId(messageId) && (
          existing().senderUid == request.auth.uid || isAdmin()
        );
    }
  }
}
