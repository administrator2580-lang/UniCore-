{
  "entities": {
    "SuperAdminRecord": {
      "title": "SuperAdminRecord",
      "description": "Authorized Super Admin identity record stored in /super_admins/{userId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the Super Admin." },
        "email": { "type": "string", "description": "Verified email address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized Admin identity record stored in /admins/{userId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the Admin." },
        "email": { "type": "string", "description": "Verified email address." },
        "grantedBy": { "type": "string", "description": "UID of the Super Admin who granted access." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "email", "grantedBy", "createdAt", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Global zero-cost quota caps, tutorial video config, and security toggles manageable only by Super Admin.",
      "type": "object",
      "properties": {
        "dailyAiLimitPerUser": { "type": "integer", "description": "Max free-tier AI tutor calls per user per day." },
        "dailyWriteLimitPerUser": { "type": "integer", "description": "Max Firestore writes per user per day." },
        "maxFileUploadBytes": { "type": "integer", "description": "Max validated file size in bytes (<= 5MB)." },
        "aiEnabled": { "type": "boolean", "description": "Global switch to pause AI features when approaching free-tier quota." },
        "zeroCostLockActive": { "type": "boolean", "description": "Forces read-only safe mode if Spark free-tier limit is reached." },
        "tutorialVideoUrl": { "type": "string", "description": "HTTPS URL for app usage tutorial video." },
        "tutorialVideoTitle": { "type": "string", "description": "Display title for app usage tutorial video." },
        "updatedBy": { "type": "string", "description": "Super Admin UID." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["dailyAiLimitPerUser", "dailyWriteLimitPerUser", "maxFileUploadBytes", "aiEnabled", "zeroCostLockActive", "updatedBy", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile without sensitive PII stored in /users/{userId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID." },
        "displayName": { "type": "string", "description": "Sanitized display name." },
        "role": { "type": "string", "enum": ["STUDENT", "ADMIN", "SUPER_ADMIN", "super_admin"], "description": "RBAC role." },
        "aiCallsToday": { "type": "integer", "description": "Daily AI Logic usage counter." },
        "writesToday": { "type": "integer", "description": "Daily Firestore write counter." },
        "quotaDayKey": { "type": "string", "description": "UTC date string YYYY-MM-DD for quota reset." },
        "accountDisabled": { "type": "boolean", "description": "If true, account is temporarily suspended by Super Admin without deletion." },
        "banUntilMillis": { "type": "integer", "description": "Epoch millis until temporary ban expires." },
        "banReason": { "type": "string", "description": "Optional reason for ban." },
        "departmentId": { "type": "string", "description": "Selected academic department ID." },
        "departmentName": { "type": "string", "description": "Selected academic department name." },
        "academicYear": { "type": "string", "description": "Selected academic year." },
        "sectionName": { "type": "string", "description": "Selected student section name." },
        "placementCompleted": { "type": "boolean", "description": "Whether student completed initial year/section onboarding." },
        "favoriteCourseIds": { "type": "array", "description": "Bounded list of user favorite course IDs." },
        "completedAssignmentIds": { "type": "array", "description": "Bounded list of assignment IDs marked completed by user." },
        "classroomConnected": { "type": "boolean", "description": "Whether Google Classroom integration was linked." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": ["userId", "displayName", "role", "aiCallsToday", "writesToday", "quotaDayKey", "createdAt", "updatedAt"]
    },
    "UserPrivatePii": {
      "title": "UserPrivatePii",
      "description": "Isolated PII record in /users/{userId}/private/{docId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "VerifiedFileRecord": {
      "title": "VerifiedFileRecord",
      "description": "Metadata for sandboxed, magic-byte-verified local file uploads.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "originalName": { "type": "string" },
        "storedName": { "type": "string" },
        "mimeType": { "type": "string", "enum": ["application/pdf", "image/png", "image/jpeg"] },
        "sizeBytes": { "type": "integer" },
        "sha256Hex": { "type": "string" },
        "status": { "type": "string", "enum": ["VERIFIED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "originalName", "storedName", "mimeType", "sizeBytes", "sha256Hex", "status", "createdAt", "updatedAt"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course with direct attached PDF/image files, lecture videos, or HTTPS study resource links.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructorId": { "type": "string" },
        "instructorName": { "type": "string" },
        "materialLink": { "type": "string" },
        "materialType": { "type": "string", "enum": ["NOTES", "PDF_LINK", "ONEDRIVE_LINK", "FILE"] },
        "hasAttachment": { "type": "boolean" },
        "attachmentName": { "type": "string" },
        "attachmentMimeType": { "type": "string" },
        "attachmentSizeBytes": { "type": "integer" },
        "chunkCount": { "type": "integer" },
        "attachmentSha256": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "videoUrl": { "type": "string" },
        "videoTitle": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "instructorId", "instructorName", "materialType", "published", "createdAt", "updatedAt"]
    },
    "CourseFileChunk": {
      "title": "CourseFileChunk",
      "description": "Base64 file chunk stored in /courses/{courseId}/chunks/{chunkId} for zero-cost direct file sharing.",
      "type": "object",
      "properties": {
        "chunkIndex": { "type": "integer" },
        "data": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chunkIndex", "data", "createdAt"]
    },
    "DriveFolderLink": {
      "title": "DriveFolderLink",
      "description": "Connected shared Google Drive folder for automatic live file sync in /drive_folders/{folderId}.",
      "type": "object",
      "properties": {
        "folderId": { "type": "string" },
        "title": { "type": "string" },
        "folderUrl": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "addedBy": { "type": "string" },
        "addedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["folderId", "title", "folderUrl", "addedBy", "addedByName", "createdAt", "updatedAt"]
    },
    "AcademicDepartment": {
      "title": "AcademicDepartment",
      "description": "Academic department and its study years/levels manageable exclusively by Admins and Super Admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "years": { "type": "array" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "years", "createdBy", "createdAt", "updatedAt"]
    },
    "AssignmentItem": {
      "title": "AssignmentItem",
      "description": "Academic assignment or Google Classroom coursework item scoped by year/section or user.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "dueAtMillis": { "type": "integer" },
        "classroomLink": { "type": "string" },
        "videoUrl": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["APP", "CLASSROOM"] },
        "ownerUid": { "type": "string" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "dueAtMillis", "sourceType", "ownerUid", "published", "createdBy", "createdByName", "createdAt", "updatedAt"]
    },
    "ScheduleItem": {
      "title": "ScheduleItem",
      "description": "Lecture, section, assignment, or exam timetable entry per academic year and section.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "itemType": { "type": "string", "enum": ["LECTURE", "SECTION", "ASSIGNMENT", "EXAM"] },
        "dayOfWeek": { "type": "integer" },
        "startTimeText": { "type": "string" },
        "endTimeText": { "type": "string" },
        "locationOrMode": { "type": "string" },
        "instructorName": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "courseId": { "type": "string" },
        "videoUrl": { "type": "string" },
        "dueAtMillis": { "type": "integer" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "itemType", "dayOfWeek", "startTimeText", "endTimeText", "locationOrMode", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "ZoomSession": {
      "title": "ZoomSession",
      "description": "Live online lecture / Zoom session link scoped by academic year and section.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "zoomUrl": { "type": "string" },
        "scheduledAtMillis": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "hostName": { "type": "string" },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "courseId": { "type": "string" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "zoomUrl", "scheduledAtMillis", "durationMinutes", "hostName", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "InstructionNotice": {
      "title": "InstructionNotice",
      "description": "General or year/section targeted academic instructions ('تعليمات للكل').",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "priority": { "type": "string", "enum": ["NORMAL", "IMPORTANT", "PINNED"] },
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "priority", "published", "createdBy", "createdByName", "createdAt", "updatedAt"]
    },
    "SectionMessage": {
      "title": "SectionMessage",
      "description": "Dedicated per-section announcement or student message.",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "departmentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "sectionName": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["STUDENT", "ADMIN", "SUPER_ADMIN"] },
        "messageType": { "type": "string", "enum": ["NOTICE", "MESSAGE"] },
        "isPinned": { "type": "boolean" },
        "text": { "type": "string" },
        "videoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["departmentName", "academicYear", "sectionName", "senderUid", "senderName", "senderRole", "messageType", "text", "createdAt"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Published quiz questions without answer keys.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "title": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "questionPrompts": { "type": "array" },
        "optionBlocks": { "type": "array" },
        "published": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "title", "durationMinutes", "questionPrompts", "optionBlocks", "published", "createdBy", "createdAt", "updatedAt"]
    },
    "QuizAnswerKey": {
      "title": "QuizAnswerKey",
      "description": "Protected answer key isolated in /quizzes/{quizId}/private/answer_key.",
      "type": "object",
      "properties": {
        "quizId": { "type": "string" },
        "correctIndices": { "type": "array" },
        "passingScore": { "type": "integer" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quizId", "correctIndices", "passingScore", "updatedBy", "createdAt", "updatedAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz submission; grades can only be finalized by Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "selectedIndices": { "type": "array" },
        "status": { "type": "string", "enum": ["SUBMITTED", "GRADED", "CANCELLED_VIOLATION"] },
        "score": { "type": "integer" },
        "graded": { "type": "boolean" },
        "gradedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "studentName", "quizId", "quizTitle", "selectedIndices", "status", "score", "graded", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security audit log entry.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string" },
        "actorLabel": { "type": "string" },
        "action": { "type": "string" },
        "severity": { "type": "string", "enum": ["INFO", "WARN", "HIGH", "CRITICAL"] },
        "targetPath": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorUid", "actorLabel", "action", "severity", "targetPath", "details", "createdAt"]
    },
    "RoleInvite": {
      "title": "RoleInvite",
      "description": "Email-based Student/Admin/SuperAdmin account pre-registration stored in /role_invites/{emailKey}.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayNameHint": { "type": "string" },
        "assignedRole": { "type": "string", "enum": ["STUDENT", "ADMIN", "SUPER_ADMIN"] },
        "invitedBy": { "type": "string" },
        "invitedByLabel": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "CLAIMED"] },
        "claimedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayNameHint", "assignedRole", "invitedBy", "invitedByLabel", "status", "createdAt", "updatedAt"]
    },
    "UniNotification": {
      "title": "UniNotification",
      "description": "Zero-cost broadcast or user-targeted notification stored in /notifications/{notificationId}.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string", "enum": ["COURSE", "QUIZ", "GRADE", "ROLE", "SECURITY", "ANNOUNCEMENT", "ASSIGNMENT", "ZOOM"] },
        "targetUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "body", "category", "targetUid", "senderUid", "senderName", "createdAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Direct tiered communication: Students -> Admins (STUDENT_TO_ADMIN) and Admins -> Super Admin (ADMIN_TO_SUPER).",
      "type": "object",
      "properties": {
        "channel": { "type": "string", "enum": ["STUDENT_TO_ADMIN", "ADMIN_TO_SUPER"] },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["STUDENT", "ADMIN"] },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "REPLIED"] },
        "replyText": { "type": "string" },
        "repliedByUid": { "type": "string" },
        "repliedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channel", "senderUid", "senderName", "senderRole", "subject", "body", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/super_admins/{userId}": {
      "schema": { "$ref": "#/entities/SuperAdminRecord" },
      "description": "Super Admin role registry."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role registry managed by Super Admin."
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Global zero-cost limits, tutorial config, and security toggles."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile, placement, favorites, and daily quota counters."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivatePii" },
      "description": "Split private PII subcollection."
    },
    "/users/{userId}/files/{fileId}": {
      "schema": { "$ref": "#/entities/VerifiedFileRecord" },
      "description": "Verified local sandbox file upload metadata."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Published and draft educational courses."
    },
    "/courses/{courseId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/CourseFileChunk" },
      "description": "Chunked Base64 PDF/image bytes attached to a course."
    },
    "/drive_folders/{folderId}": {
      "schema": { "$ref": "#/entities/DriveFolderLink" },
      "description": "Connected shared Google Drive folders for auto-sync."
    },
    "/departments/{deptId}": {
      "schema": { "$ref": "#/entities/AcademicDepartment" },
      "description": "Academic departments and years/levels writable only by Admins and Super Admins."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/AssignmentItem" },
      "description": "Academic assignments and Classroom items."
    },
    "/schedule_items/{itemId}": {
      "schema": { "$ref": "#/entities/ScheduleItem" },
      "description": "Per-section weekly lecture and assignment timetable."
    },
    "/zoom_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ZoomSession" },
      "description": "Live Zoom lecture links scoped by year and section."
    },
    "/instructions/{instructionId}": {
      "schema": { "$ref": "#/entities/InstructionNotice" },
      "description": "General or targeted academic instructions ('تعليمات للكل')."
    },
    "/section_messages/{messageId}": {
      "schema": { "$ref": "#/entities/SectionMessage" },
      "description": "Per-section notices and discussion messages."
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Quizzes without answer keys."
    },
    "/quizzes/{quizId}/private/{docId}": {
      "schema": { "$ref": "#/entities/QuizAnswerKey" },
      "description": "Protected quiz answer keys accessible only to Admins."
    },
    "/quiz_attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Student quiz attempts graded by Admins."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only immutable security audit logs."
    },
    "/role_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/RoleInvite" },
      "description": "Email-keyed Student, Admin, and Super Admin pre-registrations."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UniNotification" },
      "description": "Broadcast and per-user platform notifications."
    },
    "/support_messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Tiered support messages (Student -> Admin, Admin -> Super Admin)."
    }
  }
}
